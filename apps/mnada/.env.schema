# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Comma-separated origins trusted across all Afrotalia subdomains, e.g.
# "https://afrotalia.com,https://shop.afrotalia.com,https://mnada.afrotalia.com".
# Unset in local dev (falls back to this app's own BETTER_AUTH_URL).
# @public @optional
AUTH_TRUSTED_ORIGINS=

# Root domain for the shared session cookie in production, e.g. ".afrotalia.com".
# Leave unset in local dev.
# @public @optional
COOKIE_DOMAIN=

# Secures the settlement/non-payment cron endpoints (see nitro.config.ts).
# Set this in Vercel and Nitro's `vercel` preset wires it up automatically —
# no vercel.json cron config needed. Optional locally.
# @optional
CRON_SECRET=
